<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs these three under the hardened runtime: V8 JITs, and the
       framework loads its own unsigned-at-rest pages. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Electron's helper bundles are signed separately from the framework. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Since 1.1.1 a video clip can carry a keyboard input and a vocal input,
       and Advanced meters them. Under the hardened runtime that needs the
       audio-input entitlement, and macOS needs NSMicrophoneUsageDescription
       in Info.plist (electron-builder.yml, extendInfo) or it ends the process
       the moment an input is opened. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Deliberately absent:
       com.apple.security.get-task-allow — a debug entitlement. Apple returns
       "status: Invalid" with no explanation if it ships (macOS Signing
       Standard §5).
       com.apple.security.device.camera — nothing here uses a camera yet. -->
</dict>
</plist>
