{
  "name": "chordlight-88",
  "productName": "Chordlight 88",
  "version": "2.0.4",
  "description": "88-key MIDI note and chord display with a live Nashville number readout. Amanorsac Studio.",
  "author": {
    "name": "Amanorsac Studio",
    "email": "hello@amanorsac.studio"
  },
  "homepage": "https://amanorsac.studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs",
    "start": "electron .",
    "test:html": "node scripts/test-build.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal",
    "dist:dir": "electron-builder --dir",
    "dist:trial:win": "electron-builder --win --x64 --config electron-builder.trial.cjs",
    "dist:trial:mac": "electron-builder --mac --universal --config electron-builder.trial.cjs",
    "start:trial": "node -e \"process.env.CHORDLIGHT_EDITION='trial';require('child_process').spawn(require('electron'),['.'],{stdio:'inherit',env:process.env})\""
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}
